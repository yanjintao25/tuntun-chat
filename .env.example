# 服务
PORT=3000
NODE_ENV=development

# 飞书应用 (开放平台 -> 应用 -> 凭证与基础信息)
FEISHU_APP_ID=
FEISHU_APP_SECRET=
FEISHU_VERIFICATION_TOKEN=
FEISHU_ENCRYPT_KEY=

# 大模型 (OpenAI 兼容接口，也可填国内 API 地址)
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.siliconflow.cn/v1
OPENAI_MODEL=Qwen/Qwen3.5-9B

# 可选：数据库路径（默认项目内 data/bot.db）
# DB_PATH=./data/bot.db
